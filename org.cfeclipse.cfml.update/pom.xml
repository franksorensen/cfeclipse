<?xml version="1.0" encoding="UTF-8"?>
<project
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
	xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.cfeclipse.ide</groupId>
		<artifactId>cfeclipse</artifactId>
		<version>1.5.3</version>
	    <relativePath>../pom.xml</relativePath>
	</parent>
	<artifactId>org.cfeclipse.cfml.update</artifactId>
	<version>1.5.3</version>
	<packaging>eclipse-repository</packaging>
	<properties>
		<site.suffix></site.suffix>
		<merge.updates>false</merge.updates>
		<update.site.description>Release Build</update.site.description>
		<update.site.eclipsever>IDE 2019-09</update.site.eclipsever>
		<update.site.github>http://github.com/cfeclipse/cfeclipse</update.site.github>
		<update.site.name>CFEclipse Update</update.site.name>
		<update.site.url>http://cfeclipse.org/update${site.suffix}</update.site.url>
		<update.site.version>${project.version}</update.site.version>
	</properties>


	<repositories>
		<repository>
			<id>${repository.id}</id>
			<url>${repository.url}</url>
			<layout>p2</layout>
		</repository>
		<repository>
			<id>cflint</id>
			<layout>p2</layout>
			<url>${cflint-repo.url}</url>
		</repository>
		<repository>
			<id>cflint-dev</id>
			<layout>p2</layout>
			<url>${cflint-dev-repo.url}</url>
		</repository>
		<repository>
			<id>cfparser</id>
			<layout>p2</layout>
			<url>${cfparser-repo.url}</url>
		</repository>
		<repository>
			<id>cfparser-dev</id>
			<layout>p2</layout>
			<url>${cfparser-dev-repo.url}</url>
		</repository>
	</repositories>

	<profiles>
		<profile>
			<id>merge-updates</id>
			<activation>
				<property>
					<name>merge.updates</name>
					<value>true</value>
				</property>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.eclipse.tycho</groupId>
						<artifactId>tycho-p2-repository-plugin</artifactId>
						<version>${tycho.version}</version>
						<executions>
							<execution>
								<id>add-to-update-site</id>
								<phase>install</phase>
								<goals>
									<goal>mirror</goal>
								</goals>
								<configuration>
									<source>
										<repository>
											<url>http://cfeclipse.org/update${site.suffix}</url>
										</repository>
									</source>
									<destination>${project.build.directory}/repository</destination>
									<append>true</append>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

	<build>
		<plugins>
		</plugins>
	</build>

</project>
